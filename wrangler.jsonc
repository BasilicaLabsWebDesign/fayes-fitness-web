{
  // F.I.T: static site in public/ plus a small Worker for the app's API.
  // The Worker runs only for /api/*; everything else is served straight from public/.
  // https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fayes-fitness-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serve the themed 404 for unknown paths instead of a bare Cloudflare error.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // FLODESK_API_KEY is a secret, set on this Worker in the Cloudflare dashboard (Settings →
  // Variables and Secrets) and never written here. "true" below makes Flodesk email each new
  // sign-up a link to confirm before they join (double opt-in).
  "vars": {
    "RELEASE": "v2.41",
    "FLODESK_DOUBLE_OPTIN": "false"
  },
  "observability": {
    "enabled": true
  }
}
