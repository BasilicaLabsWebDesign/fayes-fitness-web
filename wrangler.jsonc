{
  // F.I.T: static site in public/ plus a small Worker for the app's API.
  // The Worker runs only for /api/*; everything else is served straight from public/.
  // https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fayes-fitness-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serve the themed 404 for unknown paths instead of a bare Cloudflare error.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "RELEASE": "v2.2"
  },
  "observability": {
    "enabled": true
  }
}
