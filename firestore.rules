rules_version = '2';

// F.I.T — Firestore security rules.
// Phase 0: everything is closed. Each later phase opens only what it needs:
//   - customers may read their own profile, bookings, orders and messages;
//   - nothing that touches money (orders, bookings, memberships, vouchers) is ever
//     written by a browser: only the Worker writes those, with server credentials.
// Publish with: npx firebase-tools deploy --only firestore:rules (once the project exists).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
